# ─────────────────────────────────────────────────────────────
# Supabase · скопіюй цей файл у .env та постав свої ключі
# Знайти ключі: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# URL проекту (виглядає як https://abcdefghijk.supabase.co)
VITE_SUPABASE_URL=

# Публічний anon ключ (eyJ...)
VITE_SUPABASE_ANON_KEY=
